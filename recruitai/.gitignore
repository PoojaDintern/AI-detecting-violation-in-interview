# ================================================================
# RecruitAI — .gitignore
# ================================================================

# ── Environment & Secrets ─────────────────────────────────────────
.env
*.env
.env.local
.env.production

# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# ── Virtual Environment ───────────────────────────────────────────
venv/
env/
ENV/
.venv/
.env/

# ── IDE & OS ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & Database ───────────────────────────────────────────────
*.log
*.sqlite
*.db
flask_session/

# ── Uploads & Media ───────────────────────────────────────────────
static/uploads/
static/temp/

# ── Testing ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Node (if any frontend tooling) ───────────────────────────────
node_modules/
npm-debug.log