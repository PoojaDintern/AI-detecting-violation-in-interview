# ================================================================
# RecruitAI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub — only commit .env.example
# ================================================================

# ── Flask ─────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here

# ── Supabase PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google Gemini AI ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── App Base URL ──────────────────────────────────────────────────
# Use your ngrok URL for external access, or http://localhost:5000 for local only
BASE_URL=https://your-ngrok-url.ngrok-free.dev

# ── Plugin API Key ────────────────────────────────────────────────
PLUGIN_API_KEY=your_plugin_api_key_here

# ── OTP Email (Gmail with App Password) ──────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_16char_app_password

# ── Google OAuth (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── GitHub OAuth (optional) ───────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret